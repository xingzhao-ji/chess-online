{
  "name": "chess-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "node --import tsx --watch server/cli.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/cli.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm test && npm run build"
  },
  "dependencies": { "chess.js": "^1.4.0", "react": "^19.2.0", "react-dom": "^19.2.0", "ws": "^8.18.3" },
  "devDependencies": { "@types/node": "^24.0.0", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@types/ws": "^8.18.1", "@vitejs/plugin-react": "^5.1.0", "tsx": "^4.20.0", "typescript": "^5.9.0", "vite": "^7.1.0" }
}
